# Which DB adapter the app boots with.
DB_ADAPTER=sqlite
DATABASE_URL=postgres://user:password@localhost:5432/maalaxmi_hardware

SESSION_SECRET=change-me-before-deploying

# Staff credentials: set real secret values in Vercel; never commit real passwords here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password
WORKER_USERNAME=worker
WORKER_PASSWORD=change-worker-password

# Authentication OTP destination (India country code + number, digits only).
AUTH_WHATSAPP_NUMBER=919932667908
# Connect this to a server endpoint/provider that sends the supplied code through WhatsApp.
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_WEBHOOK_TOKEN=

# Store/customer enquiry WhatsApp number.
NEXT_PUBLIC_WHATSAPP_NUMBER=919547512088
