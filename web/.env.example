# Which DB adapter the app boots with.
#   sqlite   -> zero-install local dev, uses ./data/dev.sqlite (default)
#   postgres -> production, requires DATABASE_URL below and lib/core/src/db/postgres-adapter.js
DB_ADAPTER=sqlite

# Only used when DB_ADAPTER=postgres
DATABASE_URL=postgres://user:password@localhost:5432/maalaxmi_hardware

# Session secret for the cookie-based mock auth (Phase 2). Replace with a
# real secret before deploying, and replace mock auth with real login before
# going live with real customer/staff accounts.
SESSION_SECRET=change-me-before-deploying

# Store WhatsApp number in E.164-ish digits (country code + number, no plus/spaces).
# This is also stored in business_settings (whatsapp_number) — that DB value
# is the source of truth at runtime; this env var is only a bootstrap default.
NEXT_PUBLIC_WHATSAPP_NUMBER=919547512088
